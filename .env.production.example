# Production environment template for app3.cvhowlader.com.
#
# Reference only. On cutover, run deploy/server-setup.sh: it seeds
# shared/.env from the live $BASE/.env so the existing APP_KEY is preserved.
# Never copy this file over shared/.env. CI must not generate APP_KEY:
# rotating it invalidates encrypted columns and 2FA secrets.
#
# Store the APP_KEY offline as well:
#   grep '^APP_KEY=' shared/.env

APP_NAME="Nexus Inventory"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app3.cvhowlader.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Absolute path outside releases. WAL/SHM files live next to it.
DB_CONNECTION=sqlite
DB_DATABASE=/home/cvhowlad/app3.cvhowlader.com/shared/database/database.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# No queue worker is supervised on this host. Use "sync" so jobs execute
# inline instead of silently accumulating in the jobs table. Switch to
# "database" only after a worker is provisioned.
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

PHP_MEMORY_LIMIT=256M

INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

SITEMAP_PATH=/home/cvhowlad/app3.cvhowlader.com/public/sitemap.xml
